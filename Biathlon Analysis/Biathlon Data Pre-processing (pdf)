# Functions to call for pdf files based on the race format

sprintraces <- function(df) {
  df <- df |> 
    filtering() |> 
    removefunc() |> 
    sprintgrouping() |> 
    sprintmutation() |> 
    sprintanalysis() |> 
    sprint_rates() 
}

